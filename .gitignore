# Rust build output. This is 622 MB of the tree and the single reason the repo
# had to be initialised before anything was ever committed.
target/

node_modules/

# Session scratch that lives inside the checkout: bisect worktrees (with their own
# cargo-target), link-probe scripts, and a hand-rolled test app. Ignored rather than
# deleted so tooling (ripgrep, `git stash --include-untracked`) stops tripping over
# them — a plain `git stash -u` once failed outright on the size of .bisect/.
.bisect/
.link-probe/
my-todo/

# Prebuilt natives, fetched or vendored — never source.
# Nothing needs these any more: the engine links SDL3 and Skia statically. They
# are ignored rather than merely deleted so a stale copy cannot come back.
native/
*.dll
*.dylib
*.so
*.lib
*.pdb

# Vendored archives. The SkiaSharp nupkg alone was 76 MB.
*.nupkg
*.zip
*.tar.gz

# Generated screenshots — `bun run shot` rewrites them.
engine-demo.png
engine-demo-light.png
*.out.png

# `bun run neutral --save`: renders and emitted IR from a few minutes ago, kept to
# compare a refactor against. Deliberately *not* tracked — the whole point is that
# it is a baseline you took yourself rather than a reference the repo asserts, and a
# tracked one would drift into being a second, worse set of goldens.
.baseline/

# The generated IR is a build artifact of `bun run window`. Tracked would mean
# every style change shows up as a 22 KB diff of integer arrays.
#
# The characterization goldens under `guards/characterize/golden/` are the deliberate
# exception: freezing the compiler's output is the whole point of those, and a diff
# there is the question they exist to ask.
windows/*/ui.gen.ts
windows/*.gen.ts

# The Tailwind window's stylesheet is generated by the Tailwind CLI, but it is an
# *input* to our build and the window must compile on a fresh checkout, so unlike
# the IR it is tracked.
windows/main/shot.png

.DS_Store
Thumbs.db

# MDN prose, vendored for offline grep by `bun run mdn:sync`.
# CC-BY-SA, so it is a local tool rather than part of this repo.
guards/vendor/mdn/

# Code examples extracted from the docs by `bun run docs-check`, typechecked, and
# deleted again. At the repo root rather than under docs/ because a package
# self-reference (`import … from "dziry"`) resolves against the nearest ancestor
# package.json, and docs/ is its own workspace.
.docs-examples/

# Docusaurus build output.
docs/build/
docs/.docusaurus/

# `dziry build` output — a 117 MB executable and the wrapper entry it generates.
dist/

# The working design docs are the maintainers' lab notebook — measurements,
# decision history, fix-order authority. They stay local: the public repo's
# documentation is docs/ (the site) and API.md, which the site's status badges
# parse at build time and which therefore MUST stay tracked.
ROADMAP.md
NOTES.md
BROWSER-FACTS.md
ARCHITECTURE-REVIEW.md
HANDOFF.md
REACTIVITY.md
HTML-ELEMENT-COVERAGE-RESEARCH.md
data-layer-design.md
test_output.txt

# Generated guard outputs — every one is recreated by the script beside it
# (arch-diagram, mdn:sync). The guard *inputs* stay tracked: CI runs the
# characterize goldens and the runtime-surface ratchet, and the docs render
# guards/architecture/data.ts.
guards/diagrams/
guards/vendor/
guards/arch/report.html

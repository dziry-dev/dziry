{
  "name": "dziry",
  "version": "0.1.0-beta.2",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "desktop",
    "ui",
    "framework",
    "bun",
    "skia",
    "compiled",
    "native"
  ],
  "description": "A UI framework for real desktop apps in TypeScript, HTML and CSS — compiled ahead of time, rendered by a native engine. No browser, no DOM, no webview.",
  "homepage": "https://dziry.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dziry-dev/dziry.git"
  },
  "bugs": "https://github.com/dziry-dev/dziry/issues",
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "bin": {
    "dziry": "src/cli/index.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "//exports": [
    "The package's own name is how the demo under windows/ imports it, and it is what",
    "a scaffolded project imports too — the same specifiers either way, so windows/main",
    "*is* the template rather than something a codemod has to rewrite. Bun and tsc both",
    "resolve a package's self-reference through this map.",
    "",
    "Two tiers, and the split is the API-versus-internal policy D4 asks for. The named",
    "entries are the authoring surface. The wildcards exist because the generated",
    "artifact imports `dziry/ir.ts` and `dziry/runtime/*.ts` by construction — emit()",
    "writes those specifiers — and because the host reaches for dziry/engine/*. They are",
    "not a promise."
  ],
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/compiler/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/compiler/jsx-dev-runtime.ts",
    "./ir.ts": "./src/ir.ts",
    "./runtime/*": "./src/runtime/*",
    "./compiler/*": "./src/compiler/*",
    "./engine/*": "./src/engine/*",
    "./protocol/*": "./src/protocol/*",
    "./host/*": "./src/host/*",
    "./effect": "./src/effect.ts",
    "./livestore": "./src/livestore.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "effect": "^3.22.1",
    "magic-string": "^1.1.0",
    "oxc-parser": "^0.142.0"
  },
  "peerDependencies": {
    "@livestore/livestore": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@livestore/livestore": {
      "optional": true
    }
  },
  "//optionalDependencies": [
    "One tiny package per platform, each carrying only the prebuilt engine binary",
    "with os/cpu fields — the installer keeps the one that matches and skips the",
    "rest. host.ts::enginePackagePath resolves the survivor. Versions are exact:",
    "the engine and the runtime share a protocol version, so a binary from any",
    "other release is not merely stale, it is a protocol mismatch."
  ],
  "optionalDependencies": {
    "dziry-engine-win32-x64": "0.1.0-beta.2",
    "dziry-engine-darwin-arm64": "0.1.0-beta.2",
    "dziry-engine-darwin-x64": "0.1.0-beta.2",
    "dziry-engine-linux-x64": "0.1.0-beta.2",
    "dziry-engine-linux-arm64": "0.1.0-beta.2"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "stage:engine": "bun run scripts/stage-engine-package.ts",
    "test": "bun test && bun run engine:test",
    "check": "tsc --noEmit",
    "lint": "cd native-src/dziry-engine && cargo fmt --check && cargo clippy --release --all-targets",
    "gen:protocol": "bun run scripts/gen-protocol.ts",
    "probe": "bun run scripts/probe.ts",
    "signals": "bun run scripts/signals.tsx",
    "doc-lint": "bun run scripts/doc-lint.ts",
    "protocol-guard": "bun run scripts/protocol-guard.ts",
    "characterize": "bun run scripts/characterize.ts",
    "golden": "bun run scripts/golden.ts",
    "neutral": "bun run scripts/neutrality.ts",
    "conformance": "bun run scripts/conformance.ts",
    "spec-audit": "bun run scripts/spec-audit.ts",
    "coverage:snapshot": "bun run scripts/coverage-snapshot.ts",
    "css-coverage": "bun run scripts/css-coverage.ts",
    "html-coverage": "bun run scripts/html-coverage.ts",
    "tailwind-coverage": "bun run scripts/tailwind-coverage.ts",
    "mdn:sync": "bun run scripts/mdn-sync.ts",
    "boundary-diff": "bun run scripts/boundary-diff.ts",
    "layout-diff": "bun run scripts/layout-diff.ts",
    "probe:serve": "bun run scripts/probe-server.ts",
    "arch-diagram": "bun run scripts/arch-diagram.ts",
    "arch:check": "bun run scripts/arch-diagram.ts --check",
    "engine": "cd native-src/dziry-engine && cargo build --release",
    "engine:test": "cd native-src/dziry-engine && cargo test --release",
    "engine:smoke": "bun test src/engine/smoke.test.ts",
    "engine:window": "cd native-src/dziry-engine && cargo run --release --example window",
    "engine:shot": "cd native-src/dziry-engine && cargo run --release --example window -- --screenshot ../../engine-frame.png",
    "compile": "bun run src/compile.ts",
    "routes": "bun run src/routes.ts",
    "window": "bun run src/compile-window.ts",
    "dev": "bun run src/cli/index.ts dev",
    "shot": "bun run src/cli/index.ts dev -- --screenshot engine-demo.png",
    "tw": "bun run dev",
    "tw:shot": "bun run src/cli/index.ts dev -- --screenshot windows/main/shot.png",
    "bench": "bun run scripts/bench.ts",
    "runtime-surface": "bun run scripts/runtime-surface.ts",
    "template:sync": "bun run scripts/template-sync.ts",
    "template:check": "bun run scripts/template-sync.ts --check",
    "run": "bun run windows/entry.gen.ts",
    "build": "bun run src/cli/index.ts build",
    "cli": "bun run src/cli/index.ts",
    "docs": "cd docs && bun run start",
    "docs:build": "bun run doc-lint --quiet && bun run docs-check --quiet && cd docs && bun run build",
    "docs:serve": "cd docs && bun run serve",
    "docs:version": "cd docs && bun run docusaurus docs:version",
    "docs-check": "bun run scripts/docs-check.ts"
  },
  "devDependencies": {
    "@livestore/livestore": "^0.4.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "mdn-data": "^2.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "zod": "^4.4.3"
  }
}
